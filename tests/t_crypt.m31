// Unit tests for HOARD_crypt.
//
// The vectors are the SHA-512 ones from the specification
// (https://www.akkadia.org/drepper/SHA-crypt.txt) and ones made with
// `openssl passwd -6 -salt <salt> -stdin`, the password on stdin.
//
// Output: one `ok`/`FAIL` line per check and a last line `N passed, M failed`.

import core.HOARD_crypt;

type Tally {
    int passed = 0;
    int failed = 0;
}

void Tally.same(str name, str got, str want) {
    if (got == want) {
        passed = passed + 1;
        print("ok   " + name);
    } else {
        failed = failed + 1;
        print("FAIL " + name + ": got [" + got + "] want [" + want + "]");
    }
}

void Tally.check(str name, bool is_actual, bool is_expected) {
    same(name, is_actual.to_str(), is_expected.to_str());
}

void Tally.verifies(str name, str password, str stored) {
    check(name, HOARD_crypt.is_password_correct(password, stored), true);
}

void Tally.refuses(str name, str password, str stored) {
    check(name, HOARD_crypt.is_password_correct(password, stored), false);
}

Tally tally = Tally();

// --- the specification's SHA-512 vectors ----------------------------------------

tally.verifies("spec: saltstring", "Hello world!", "$6$saltstring$svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1");
tally.verifies("spec: rounds=10000", "Hello world!", "$6$rounds=10000$saltstringsaltst$OW1/O6BYHV6BcXZu8QVeXbDWra3Oeqh0sbHbbMCVNSnCM/UrjmM0Dp8vOuZeHBy/YTBmSK6H9qs/y3RnOaw5v.");
tally.verifies("spec: rounds=5000 written out", "This is just a test", "$6$rounds=5000$toolongsaltstrin$lQ8jolhgVRVhY4b5pZKaysCLi0QBxGoNeKQzQ3glMhwllF7oGDZxUhx1yxdYcz/e1JSbq3y6JMxxl8audkUEm0");
tally.verifies("spec: rounds=1400, long password", "a very much longer text to encrypt.  This one even stretches over morethan one line.", "$6$rounds=1400$anotherlongsalts$POfYwTEok97VWcjxIiSOjiykti.o/pQs.wPvMxQ6Fm7I6IoYN3CmLs66x9t0oSwbtEW7o7UmJEiDwGqd8p4ur1");
tally.verifies("spec: rounds=77777, short salt", "we have a short salt string but not a short password", "$6$rounds=77777$short$WuQyW2YR.hBNpjjRhpYD/ifIw05xdfeEyQoMxIXbkvr0gge1a1x3yRULJ5CCaUeOxFmtlcGZelFl5CxtgfiAc0");
tally.verifies("spec: rounds=123456, 16-char salt", "a short string", "$6$rounds=123456$asaltof16chars..$BtCwjqMJGx5hrJhZywWvt0RLE8uZ4oPwcelCjmw2kSYu.Ec6ycULevoBK25fs2xXgMNrCzIMVcgEJAstJeonj1");
tally.verifies("spec: rounds=1000 (clamped from 10)", "the minimum number is still observed", "$6$rounds=1000$roundstoolow$kUMsbe306n21p9R.FRkW3IGn.S9NPN0x50YhH1xhLsPuWGsUSklZt58jaTfF4ZEQpyUNGc0dqbpBYYBaHHrsX.");
tally.verifies("spec: rounds=10 is read as 1000", "the minimum number is still observed", "$6$rounds=10$roundstoolow$kUMsbe306n21p9R.FRkW3IGn.S9NPN0x50YhH1xhLsPuWGsUSklZt58jaTfF4ZEQpyUNGc0dqbpBYYBaHHrsX.");

// --- openssl passwd -6 -salt <salt> -stdin ----------------------------------------

tally.verifies("openssl: one-char password and salt", "a", "$6$x$6Zqbz8j5rMHIeJ1ujjjFXuZXSa/VORj.fVUEQcJc.rjR9.wCKlhZuymRQLtIEzcxNmqwX/fRNvM45BbvFayY51");
tally.verifies("openssl: 63-byte password", "p".repeat(63), "$6$abcdefghijklmnop$IaxxGNiHJagUfa83D.u9p65gHs9Gl8Oi2rzlTwT.FZocQHHCUqZANCiEgQNPmQZBRNHZ9Nt6fB5HimE71eOu51");
tally.verifies("openssl: 64-byte password", "q".repeat(64), "$6$0123456789./AZaz$t6f0Q36wDdTHyxzUp66eBILTjkYExddzOG/A35DEV3FFDYUEXvHLyIFyBr0L2.2DMH0pa4X4r1pxp82dB45Jr.");
tally.verifies("openssl: 65-byte password", "r".repeat(65), "$6$Z$qxS4BiCFcvIekmPG.cwGOpmdmzTxHMLMfUyGOIcDvleNb3KPDECeSiD7ti.ig0N4NhTULWBcK5Py/vye/xUPa.");
tally.verifies("openssl: UTF-8 password", "pässwörd ünïcödé €", "$6$mid.salt/9$l7MmqXzR7.FJBvRUgDXkGTMYkeP788cX0KKO8Ih170uTPKw4FWSUaO21fcB4ZtXjFvIQn8h/op6hdiwdEoHTm/");
tally.verifies("openssl: tab, dollar and colon", "tab\there $x:y", "$6$dollar$iy32xlnMFZYoC/wTCl8coQQGWWvGmvGtZPQ9Lhlsfcu2SiqqwgKS.1LYTIBhCxWpWBUJf6lAPq5Hm8bEhwyr30");
tally.verifies("openssl: 200-byte password", "0123456789".repeat(20), "$6$long$9xNRd/YVuZxbyiR4z252z1/dbS8a9tTICawuoMQ2uotiKHgOfKE6l/pgzzDaW7IhysfKCH0EYd2HoNfaJ52wK/");
tally.verifies("openssl: rounds=1000", "hunter2", "$6$rounds=1000$r1000$v2r9hxoJ.5pkBl9M8ySz.U45WN2juRSxgWnkSYhDfcqTKbmphM9Hpl1U/.3cBiqfKq4X6mO9KYizpR9z/5WIk/");

// --- wrong passwords ----------------------------------------------------------------

str spec_hash = "$6$saltstring$svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1";
tally.refuses("wrong: one character off", "Hello world?", spec_hash);
tally.refuses("wrong: prefix of the password", "Hello world", spec_hash);
tally.refuses("wrong: case", "hello world!", spec_hash);
tally.refuses("wrong: rounds differ", "Hello world!", "$6$rounds=5001$saltstring$svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1");

// --- malformed stored hashes --------------------------------------------------------

str good_tail = "svn8UoSVapNtMuq1ukKS4tPQd8iKwSMHWjl/O817G3uBnIFNjnQJuesI68u4OTLiBFdcbYEdFCoEOfaS35inz1";
tally.refuses("malformed: empty", "Hello world!", "");
tally.refuses("malformed: $5$ (SHA-256)", "Hello world!", "$5$saltstring$" + good_tail);
tally.refuses("malformed: no prefix", "Hello world!", "saltstring$" + good_tail);
tally.refuses("malformed: empty salt", "Hello world!", "$6$$" + good_tail);
tally.refuses("malformed: salt of 17", "Hello world!", "$6$saltstringsaltst$" + good_tail);
tally.refuses("malformed: no hash", "Hello world!", "$6$saltstring$");
tally.refuses("malformed: no '$' after the salt", "Hello world!", "$6$saltstring");
tally.refuses("malformed: hash one short", "Hello world!", "$6$saltstring$" + good_tail.substr(0, 85));
tally.refuses("malformed: hash one long", "Hello world!", "$6$saltstring$" + good_tail + "a");
tally.refuses("malformed: trailing newline", "Hello world!", "$6$saltstring$" + good_tail + "\n");
tally.refuses("malformed: rounds= with no salt", "Hello world!", "$6$rounds=5000$");
tally.refuses("malformed: rounds= alone", "Hello world!", "$6$rounds=5000");

// --- hash_password -> is_password_correct ------------------------------------------------

match (HOARD_crypt.hash_password("correct horse battery staple")) {
    case Ok(str made): {
        tally.check("round trip: starts with $6$", made.starts_with("$6$"), true);
        tally.same("round trip: length 3 + 16 + 1 + 86", made.size().to_str(), "106");
        tally.same("round trip: '$' separators", made.split("$").size().to_str(), "4");
        tally.check("round trip: no rounds= field", made.contains("rounds="), false);
        tally.verifies("round trip: verifies", "correct horse battery staple", made);
        tally.refuses("round trip: wrong password", "correct horse battery stapler", made);
        bool is_alphabet = true;
        str alphabet = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
        for (int index in 3 .. made.size()) {
            str character = made.substr(index, index + 1);
            if (character != "$" && !alphabet.contains(character)) {
                is_alphabet = false;
            }
        }
        tally.check("round trip: salt and hash in ./0-9A-Za-z", is_alphabet, true);
        match (HOARD_crypt.hash_password("correct horse battery staple")) {
            case Ok(str again): {
                tally.check("round trip: a second hash has a new salt", again.substr(3, 19) != made.substr(3, 19), true);
                tally.verifies("round trip: the second verifies too", "correct horse battery staple", again);
            }
            case Err(str reason): {
                tally.same("round trip: second hash", reason, "");
            }
        }
    }
    case Err(str reason): {
        tally.same("round trip: hash_password", reason, "");
    }
}
tally.check("hash_password: empty is Err", HOARD_crypt.hash_password("").is_err(), true);
tally.check("hash_password: newline is Err", HOARD_crypt.hash_password("a\nb").is_err(), true);

// --- password_problem ------------------------------------------------------------------

tally.same("problem: fine", HOARD_crypt.password_problem("hunter2"), "");
tally.same("problem: 1024 bytes is fine", HOARD_crypt.password_problem("x".repeat(1024)), "");
tally.same("problem: empty", HOARD_crypt.password_problem(""), "the password is empty");
tally.same("problem: newline", HOARD_crypt.password_problem("a\nb"), "the password contains a line break or a NUL byte");
tally.same("problem: carriage return", HOARD_crypt.password_problem("a\r"), "the password contains a line break or a NUL byte");
tally.same("problem: NUL", HOARD_crypt.password_problem("\0a"), "the password contains a line break or a NUL byte");
tally.same("problem: 1025 bytes", HOARD_crypt.password_problem("x".repeat(1025)), "the password is longer than 1024 bytes");
tally.refuses("verify: an empty password is refused", "", spec_hash);
tally.refuses("verify: a password with a newline is refused", "Hello world!\n", spec_hash);

// --- is_ct_equal ---------------------------------------------------------------------------

bytes empty = [];
tally.check("is_ct_equal: same", HOARD_crypt.is_ct_equal("abc".to_bytes(), "abc".to_bytes()), true);
tally.check("is_ct_equal: both empty", HOARD_crypt.is_ct_equal(empty, empty), true);
tally.check("is_ct_equal: last octet differs", HOARD_crypt.is_ct_equal("abc".to_bytes(), "abd".to_bytes()), false);
tally.check("is_ct_equal: first octet differs", HOARD_crypt.is_ct_equal("abc".to_bytes(), "xbc".to_bytes()), false);
tally.check("is_ct_equal: right longer", HOARD_crypt.is_ct_equal("abc".to_bytes(), "abcd".to_bytes()), false);
tally.check("is_ct_equal: right shorter", HOARD_crypt.is_ct_equal("abc".to_bytes(), "ab".to_bytes()), false);
tally.check("is_ct_equal: left empty", HOARD_crypt.is_ct_equal(empty, "a".to_bytes()), false);
tally.check("is_ct_equal: right empty", HOARD_crypt.is_ct_equal("a".to_bytes(), empty), false);
print(str(tally.passed) + " passed, " + str(tally.failed) + " failed");
